# Paths are absolute or relative to src/.
JOBS_ROOT=jobs
PROFILES_ROOT=profiles
# Leave empty to detect a local installation. Use an absolute path for portable or custom installs.
ORCA_SLICER_BIN=

# Copy this file to src/.env. Keep local until you have provider credentials.
LLM_MODE=local
# OpenAI-compatible base URL from the provider, usually ending in /v1/.
# AI-SLICE appends chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# auto works with providers that do not accept a forced function name.
# Set named if your provider supports forcing a specific function.
LLM_TOOL_CHOICE=auto
